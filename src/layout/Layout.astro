---
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Fondos y neutros */
    --blanco: #ffffff;
    --negro: #000000;
    --gris-claro: #f5f7fa;
    --gris-700: #686f7c;
    --gris-600: #414651;
    --gris-500: #343944;
    --gris-400: #2d2d2d;
    --gris-300: #292d36;
    --gris-200: #20242c;

    /* Azules oscuros */
    --azul-noche: #050042;
    --azul-noche-profundo: #030021;

    /* Azules de acento */
    --azul-claro: #0195e7;
    --azul-medio: #0074bd;
    --azul-oscuro: #0065a9;

    /* Rojo */
    --rojo: #ea2d2e;

    /* Alias con significado (provisionales hasta que me confirmes el Figma) */
    --color-fondo: var(--gris-claro);
    --color-texto: var(--gris-200);
    --color-principal: var(--azul-claro);

    --fuente-base: 'DM Sans', system-ui, sans-serif;
    --altura-navbar: 90px;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: var(--color-fondo);
    color: var(--color-texto);
    font-family: var(--fuente-base);
    line-height: 1.5;
  }

  section {
    scroll-margin-top: var(--altura-navbar);
  }
</style>