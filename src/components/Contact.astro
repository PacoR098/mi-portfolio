---
import cv from '../data/cv.json';
---

<section id="contact" class="contact">
  <div class="contact__contenido">
    <p class="contact__etiqueta">CONTACT</p>
    <h2 class="contact__titulo">WHAT’S NEXT?</h2>

    <ul class="contact__lista">
      {cv.contacto.map((medio) => (
        <li>
          <a
            class="cubo"
            href={medio.enlace}
            target={medio.enlace.startsWith('http') ? '_blank' : undefined}
            rel="noopener"
          >
            <img class="cubo__imagen" src={medio.imagen} alt="" />
            <span class="cubo__nombre">{medio.nombre}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact {
    display: flex;
    align-items: center;
    padding: 80px 20px;
    text-align: center;
  }

  .contact__contenido {
    width: 100%;
    max-width: var(--ancho-contenido);
    margin: 0 auto;
  }

  .contact__etiqueta {
    font-size: 18px;
  }

  .contact__titulo {
    font-size: 28px;
    font-weight: 400;
  }

  .contact__lista {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 90px;
    margin-top: 80px;
    list-style: none;
  }

  .cubo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    font-size: 15px;
    transition: color 0.2s ease-in-out;
  }

  .cubo__imagen {
    width: 160px;
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .cubo:hover {
    color: var(--color-principal);
  }

  .cubo:hover .cubo__imagen {
    transform: translateY(-10px);
    filter: drop-shadow(0 0 14px rgba(1, 149, 231, 0.6));
  }
</style>