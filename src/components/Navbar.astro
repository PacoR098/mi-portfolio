<header class="header">
  <nav class="navbar">
    <a href="#home" class="navbar__logo">Francisco Romero<span>.</span></a>
    <ul class="navbar__links">
      <li><a href="#home">HOME</a></li>
      <li><a href="#about">ABOUT ME</a></li>
      <li><a href="#experience">EXPERIENCE</a></li>
      <li><a href="#projects">PROJECTS</a></li>
      <li><a href="#contact">CONTACT</a></li>
    </ul>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--altura-navbar);
    margin-bottom: calc(var(--altura-navbar) * -1);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 20px;
  }

  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: var(--ancho-contenido);
    height: 66px;
    padding: 0 40px;
    background: var(--azul-noche);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
  }

  .navbar__logo {
    font-size: 16px;
    font-weight: 700;
  }

  .navbar__logo span {
    color: var(--rojo);
  }

  .navbar__links {
    display: flex;
    gap: 40px;
    list-style: none;
  }

  .navbar__links a {
    border-radius: 999px;
    border: 2px solid transparent;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 700;
    transition: all 0.2s ease-in-out;
  }

  .navbar__links a:hover,
  .navbar__links a.activo {
    background: var(--azul-noche-profundo);
    color: var(--color-principal);
    border: 2px solid var(--color-principal);
  }
</style>

<script>
  const enlaces = document.querySelectorAll('.navbar__links a');
  const secciones = document.querySelectorAll('section[id]');

  const observador = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((entrada) => {
        if (entrada.isIntersecting) {
          enlaces.forEach((enlace) => {
            enlace.classList.toggle(
              'activo',
              enlace.getAttribute('href') === '#' + entrada.target.id
            );
          });
        }
      });
    },
    { rootMargin: '-50% 0px -50% 0px' }
  );

  secciones.forEach((seccion) => observador.observe(seccion));
</script>