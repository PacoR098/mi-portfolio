<header class="header">
  <nav class="navbar">
    <a href="#home" class="navbar__logo">Francisco Romero<span>.</span></a>
    <ul class="navbar__links">
      <li><a href="#home">HOME</a></li>
      <li><a href="#about">ABOUT ME</a></li>
      <li><a href="#experience">EXPERIENCE</a></li>
      <li><a href="#projects">PROJECTS</a></li>
      <li><a href="#contact">CONTACT</a></li>
    </ul>
  </nav>
</header>

<style>
  .header {
    position: sticky;          /* se queda pegada arriba al hacer scroll */
    top: 0;
    z-index: 10;               /* siempre por encima del contenido */
    height: var(--altura-navbar);
    display: flex;
    justify-content: center;   /* centra la píldora en horizontal */
    align-items: center;       /* y en vertical */
    padding: 0 20px;
  }

  .navbar {
    display: flex;
    justify-content: space-between; /* logo a la izquierda, enlaces a la derecha */
    align-items: center;
    width: 100%;
    max-width: var(--ancho-contenido);
    height: 66px;
    padding: 0 40px;
    background: var(--azul-noche);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;       /* esquinas redondeadas */
  }

  .navbar__logo {
    font-size: 16px;
    font-weight: 700;
  }

  .navbar__logo span {
    color: var(--rojo);        /* el punto rojo del logo */
  }

  .navbar__links {
    display: flex;
    gap: 40px;                 /* separación entre enlaces */
    list-style: none;
  }

  .navbar__links a {
    border-radius: 999px;              /* píldora totalmente redondeada */
    border: 2px solid transparent;     /* para que el tamaño no cambie al hacer hover */
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 700;
    transition: all 0.2s ease-in-out;  /* el cambio es suave al entrar y al salir */
  }

  /* El enlace activo se ve igual que cuando pasas el ratón */
  .navbar__links a:hover,
  .navbar__links a.activo {
    background: var(--azul-noche-profundo);
    color: var(--color-principal);
    border: 2px solid var(--color-principal);
  }
</style>

<script>
  // Marca como activo el enlace de la sección que estás viendo
  const enlaces = document.querySelectorAll('.navbar__links a');
  const secciones = document.querySelectorAll('section[id]');

  const observador = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((entrada) => {
        if (entrada.isIntersecting) {
          enlaces.forEach((enlace) => {
            enlace.classList.toggle(
              'activo',
              enlace.getAttribute('href') === '#' + entrada.target.id
            );
          });
        }
      });
    },
    { rootMargin: '-50% 0px -50% 0px' }
  );

  secciones.forEach((seccion) => observador.observe(seccion));
</script>